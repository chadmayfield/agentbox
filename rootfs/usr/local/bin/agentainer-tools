#!/bin/sh
# agentainer-tools status|reset: show or reset the tools that agents installed.
set -eu
# shellcheck source=rootfs/usr/local/lib/agentainer/tools-layout.sh
. /usr/local/lib/agentainer/tools-layout.sh
active=/var/lib/agentainer/active
case "${1:-status}" in
status)
	root=$(readlink "$active" 2>/dev/null || echo none)
	case "$root" in
	"$HOME/.agentainer/tools") mode=persist ;;
	/var/lib/agentainer/tools) mode=ephemeral ;;
	none) mode=uninitialized ;;
	*) mode=unknown ;;
	esac
	printf 'mode: %s\nroot: %s\n' "$mode" "$root"
	ls "$active/bin" "$active/npm/bin" "$active/python/bin" 2>/dev/null || true
	;;
reset)
	mkdir -p "$HOME/.agentainer"
	exec 9>"$HOME/.agentainer/.tools-reset.lock"
	if ! flock -w 30 9; then
		echo "agentainer-tools: $HOME/.agentainer/.tools-reset.lock is still held after 30 seconds by another reset or an agentainer-extras install or remove; try again when it finishes" >&2
		exit 1
	fi
	dir="$HOME/.agentainer/tools"
	if [ -d "$dir" ]; then
		# Reserve a unique destination, including across container PID namespaces.
		dest=$(mktemp -d "$dir.$(date -u +%Y%m%dT%H%M%SZ).XXXXXX.bak")
		mv -T "$dir" "$dest"
		tools_mkdirs "$dir"
		rm -f "$HOME/.agentainer/tools-image-version"
		echo "moved $dir to $dest"
	else
		echo "no persisted tools"
	fi
	;;
*)
	echo "usage: agentainer-tools status|reset" >&2
	exit 2
	;;
esac
