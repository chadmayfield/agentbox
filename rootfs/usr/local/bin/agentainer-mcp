#!/usr/bin/python3 -I
"""agentainer-mcp sync [--if-changed]|list: apply ~/.agentainer/mcp.json to every agent.

Only servers this tool added (recorded in ~/.agentainer/mcp-managed.json) are ever
changed or removed. A value of exactly ${NAME} (or "Bearer ${NAME}" for headers) is a
reference and is never replaced with the variable's value.

How each agent is updated (checked against agent versions pinned in versions.env):
  claude    mcpServers in ~/.claude.json (or $CLAUDE_CONFIG_DIR/.claude.json)
  agy       mcpServers in ~/.gemini/config/mcp_config.json
  codex     its [mcp_servers.<name>] tables in ~/.codex/config.toml, rewritten as
            one marked block at the end; every other line is kept
  opencode  agentainer-owned mcp.servers.<name> entries in ~/.config/opencode/opencode.json
            (OpenCode v2 has no "mcp remove" command)
--if-changed skips a successful sync whose input has not changed. Both modes lock the
whole read, update and write operation on a shared home.
Exit status: 0 when every agent was updated, 1 otherwise (the entrypoint retries next start).
"""
import contextlib
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
import time

try:
    import tomllib  # Python 3.11+; the image has 3.14
except ImportError:  # host-side unit tests on older Python
    tomllib = None

REF = re.compile(r"^\$\{([A-Za-z_][A-Za-z0-9_]*)\}$")
BEARER = re.compile(r"^Bearer \$\{([A-Za-z_][A-Za-z0-9_]*)\}$")
AGENTS = ("claude", "codex", "opencode", "agy")
# Keys each kind of server entry may have. "type" follows Claude Code's .mcp.json
# ("stdio", "http" or "sse"; https://code.claude.com/docs/en/mcp).
KEYS = {"command": {"type", "command", "args", "env"}, "url": {"type", "url", "headers"}}
TYPES = {"command": (None, "stdio"), "url": (None, "http", "sse")}
MARK_BEGIN = "# >>> agentainer-mcp: managed servers; edit ~/.agentainer/mcp.json instead >>>"
MARK_END = "# <<< agentainer-mcp <<<"


class Invalid(Exception):
    pass


def _check_str_map(name, field, value):
    if not isinstance(value, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in value.items()):
        raise Invalid("server %r: %s must map names to strings" % (name, field))


def load_desired(path, warn=None):
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    except ValueError as e:
        raise Invalid("%s is not valid JSON: %s" % (path, e))
    servers = data.get("mcpServers") if isinstance(data, dict) else None
    if not isinstance(servers, dict):
        raise Invalid('%s must contain an object "mcpServers"' % path)
    for name, s in servers.items():
        if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
            raise Invalid("server name %r may only use letters, digits, - and _" % name)
        if not isinstance(s, dict) or ("command" in s) == ("url" in s):
            raise Invalid("server %r needs exactly one of command or url" % name)
        if "command" in s:
            if not isinstance(s["command"], str):
                raise Invalid("server %r: command must be a string" % name)
            args = s.get("args", [])
            if not isinstance(args, list) or not all(isinstance(a, str) for a in args):
                raise Invalid("server %r: args must be a list of strings" % name)
            _check_str_map(name, "env", s.get("env", {}))
        else:
            if not isinstance(s["url"], str):
                raise Invalid("server %r: url must be a string" % name)
            _check_str_map(name, "headers", s.get("headers", {}))
        kind = "command" if "command" in s else "url"
        if s.get("type") not in TYPES[kind]:
            raise Invalid("server %r: type must be one of %s for a %s server" % (
                name, ", ".join(t for t in TYPES[kind] if t), kind))
        extra = sorted(set(s) - KEYS[kind])
        if extra and warn:
            warn("%s: %s not supported by agentainer-mcp; left out for every agent" % (name, ", ".join(extra)))
    return servers


def is_sse(s):
    return s.get("type") == "sse"


def ref_name(value):
    m = REF.match(value)
    return m.group(1) if m else None


def check_partial(warn, agent, name, field, value):
    if "${" in value and not REF.match(value) and not BEARER.match(value):
        warn("%s: %s on %s: only exact ${NAME} or \"Bearer ${NAME}\" values are references; "
             "this one is written as literal text" % (agent, field, name))


def write_atomic(path, text, private=False):
    # Write through a symlink, so a linked config (a dotfiles repo, say) stays linked.
    path = os.path.realpath(path)
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    # A unique temp name: containers sharing one home volume may write at the same time.
    fd, tmp = tempfile.mkstemp(dir=d, prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())  # the data is on disk before the rename makes it visible
        try:
            mode = os.stat(path).st_mode & 0o7777
        except FileNotFoundError:
            mode = 0o600  # agent configs may contain literal credentials
        if private:
            mode &= 0o600
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


# ---- JSON configuration for Claude Code and Antigravity --------------------------
# Paths and shapes checked with `claude mcp add-json --scope user` and `agy mcp add`.
# Claude's user scope: https://code.claude.com/docs/en/mcp
# Write the files directly: both CLIs accept server configuration only in argv.


def claude_entry(name, s, warn):
    if "command" in s:
        return {"type": "stdio", "command": s["command"], "args": s.get("args", []), "env": s.get("env", {})}
    return {"type": s.get("type") or "http", "url": s["url"], "headers": s.get("headers", {})}


def agy_entry(name, s, warn):
    if "command" in s:
        env = {}
        for k, v in s.get("env", {}).items():
            if ref_name(v) is None:
                check_partial(warn, "agy", name, k, v)
                env[k] = v
            else:
                warn("agy: %s on %s is a ${VAR} reference; agy has no documented syntax for it, so it "
                     "is left out and the server relies on the inherited environment" % (k, name))
        return {"command": s["command"], "args": s.get("args", []), "env": env, "disabled": False}
    if is_sse(s):
        warn("agy: %s uses SSE; agy mcp add supports only stdio and http, so it is left out" % name)
        return None
    headers = {}
    for k, v in s.get("headers", {}).items():
        if "${" in v:
            warn("agy: header %s on %s uses ${VAR}; not written, add it by hand" % (k, name))
        else:
            headers[k] = v
    return {"serverUrl": s["url"], "headers": headers, "disabled": False}


def agent_config_path(agent, env):
    home = env["HOME"]
    if agent == "claude":
        return os.path.join(env.get("CLAUDE_CONFIG_DIR") or home, ".claude.json")
    return os.path.join(home, {"agy": ".gemini/config/mcp_config.json",
                               "codex": ".codex/config.toml",
                               "opencode": ".config/opencode/opencode.json"}[agent])


def sync_json_agent(agent, env, desired, managed, warn):
    path = agent_config_path(agent, env)
    try:
        with open(path) as f:
            text = f.read()
        data = json.loads(text) if text.strip() else {}
    except FileNotFoundError:
        data = {}
    if not isinstance(data, dict) or not isinstance(data.setdefault("mcpServers", {}), dict):
        raise ValueError("invalid mcpServers object")
    servers = data["mcpServers"]
    for name in managed:
        if name not in desired:
            servers.pop(name, None)
    entry = claude_entry if agent == "claude" else agy_entry
    result = []
    for name, server in desired.items():
        if name in servers and name not in managed:
            warn("%s already has a server named %s that agentainer did not add; leaving it" % (agent, name))
            continue
        value = entry(name, server, warn)
        if value is None:
            servers.pop(name, None)  # no stale managed entry for an unsupported transport
            continue
        servers[name] = value
        result.append(name)
    return path, json.dumps(data, indent=2, ensure_ascii=False) + "\n", result


# ---- codex (config.toml block) --------------------------------------------------
# codex mcp add cannot set env_vars or headers. Keys from
# https://learn.chatgpt.com/docs/config-file/config-reference. Codex passes a stdio
# server only its defaults, env_vars and env (codex-rs/rmcp-client/src/utils.rs).

def toml_str(s):
    # JSON string syntax is TOML basic-string syntax once non-ASCII stays literal
    # (TOML forbids surrogate escapes) and DEL is escaped (TOML forbids it raw).
    return json.dumps(s, ensure_ascii=False).replace("\x7f", "\\u007F")


def toml_val(v):
    if isinstance(v, list):
        return "[" + ", ".join(toml_str(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join("%s = %s" % (toml_str(k), toml_str(x)) for k, x in v.items()) + " }"
    return toml_str(v)


def codex_table(name, s, warn):
    if is_sse(s):
        # "codex mcp add --help": --url is "URL for a streamable HTTP MCP server".
        warn("codex: %s uses SSE; Codex supports only streamable HTTP, so it is left out" % name)
        return None
    lines = ["[mcp_servers.%s]" % name]
    if "command" in s:
        lines.append("command = %s" % toml_str(s["command"]))
        if s.get("args"):
            lines.append("args = %s" % toml_val(s["args"]))
        static, passthru = {}, []
        for k, v in s.get("env", {}).items():
            n = ref_name(v)
            if n is None:
                check_partial(warn, "codex", name, k, v)
                static[k] = v
            elif n == k:
                passthru.append(k)
            else:
                warn("codex: %s=${%s} on %s: Codex passes variables only under their own name; "
                     "rename one so they match" % (k, n, name))
        if static:
            lines.append("env = %s" % toml_val(static))
        if passthru:
            lines.append("env_vars = %s" % toml_val(passthru))
    else:
        lines.append("url = %s" % toml_str(s["url"]))
        static, from_env = {}, {}
        for k, v in s.get("headers", {}).items():
            m = BEARER.match(v)
            if k.lower() == "authorization" and m:
                lines.append("bearer_token_env_var = %s" % toml_str(m.group(1)))
            elif m:
                # env_http_headers sends the variable's value as the whole header value.
                warn("codex: header %s on %s is \"Bearer ${%s}\"; Codex can send a variable only as "
                     "the whole value, so the header is left out (store \"Bearer ...\" in the variable "
                     "and use ${%s} to pass it)" % (k, name, m.group(1), m.group(1)))
            elif ref_name(v):
                from_env[k] = ref_name(v)
            else:
                check_partial(warn, "codex", name, k, v)
                static[k] = v
        if static:
            lines.append("http_headers = %s" % toml_val(static))
        if from_env:
            lines.append("env_http_headers = %s" % toml_val(from_env))
    return "\n".join(lines) + "\n"


# Codex rewrites config.toml with its own TOML editor. "codex plugin add" puts its
# tables between the marker comments and "codex mcp add" can drop the begin marker,
# so the markers only label the block; ownership goes by server name.
# A table header, from TOML's key grammar: bare or quoted parts joined by dots, with
# spaces or tabs around the dots. Quoted parts may contain "]". Each character can
# match only one way, so a line that is not a header fails in linear time.
TOML_KEY = r"""(?:"(?:[^"\\]|\\.)*"|'[^']*'|[A-Za-z0-9_-]+)"""
CODEX_HEADER = re.compile(r"^\[\[?[ \t]*(%s(?:[ \t]*\.[ \t]*%s)*)[ \t]*\]\]?[ \t]*(#.*)?$" % (TOML_KEY, TOML_KEY))
CODEX_LAYOUT = ("codex: config.toml would lose settings agentainer does not manage, or uses a layout "
                "agentainer cannot rewrite safely; nothing written")
TOML_KEY_PART = re.compile(r"""\s*(?:"((?:[^"\\]|\\.)*)"|'([^']*)'|([A-Za-z0-9_-]+))\s*(?:\.|$)""")
# The keys codex_table writes. Other keys on one of our servers (enabled,
# enabled_tools, tools.<tool>.approval_mode and so on) belong to the user and are kept.
CODEX_OWN_KEYS = {"command", "args", "env", "env_vars", "url", "bearer_token_env_var",
                  "http_headers", "env_http_headers"}


def toml_key_parts(key):
    """The parts of a dotted TOML key with quotes removed, or None if KEY is not one."""
    parts, pos = [], 0
    while pos < len(key):
        m = TOML_KEY_PART.match(key, pos)
        if not m or m.end() == pos:
            return None
        parts.append(next(g for g in m.groups() if g is not None))
        pos = m.end()
    return parts or None


def codex_header_parts(line):
    """The key parts of a table header line, or None when LINE is not a header."""
    header = CODEX_HEADER.match(line.strip())
    return (toml_key_parts(header.group(1)) or []) if header else None


def codex_owned_header(line, owned):
    """True for [mcp_servers.<name>] or a sub-table of it, with <name> in OWNED;
    False for any other table header; None when LINE is not a header."""
    parts = codex_header_parts(line)
    if parts is None:
        return None
    return len(parts) >= 2 and parts[0] == "mcp_servers" and parts[1] in owned


def codex_marked_names(text):
    """Server names inside one intact pair of markers, used when the manifest has no
    Codex entry."""
    lines = [line.strip() for line in text.splitlines()]
    if lines.count(MARK_BEGIN) != 1 or lines.count(MARK_END) != 1:
        return set()
    names = set()
    for line in lines[lines.index(MARK_BEGIN) + 1:lines.index(MARK_END)]:
        parts = codex_header_parts(line) or []
        if len(parts) == 2 and parts[0] == "mcp_servers":
            names.add(parts[1])
    return names


def codex_drop_owned(text, owned):
    """TEXT without the marker lines and without the headers, keys and blank lines of
    the [mcp_servers.<name>] tables (and sub-tables) for names in OWNED. Comments and
    every other line stay as they are."""
    keep, dropping = [], False
    for line in text.splitlines(keepends=True):
        stripped = line.strip()
        if stripped in (MARK_BEGIN, MARK_END):
            continue
        owned_header = codex_owned_header(line, owned)
        if owned_header is not None:
            dropping = owned_header
        if not dropping or stripped.startswith("#"):
            keep.append(line)
    return "".join(keep)


def toml_key(k):
    return k if re.fullmatch(r"[A-Za-z0-9_-]+", k) else toml_str(k)


def toml_any(v):
    """V, a value of a type tomllib returns, written as a TOML value."""
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        if v != v:
            return "nan"
        return {float("inf"): "inf", float("-inf"): "-inf"}.get(v, repr(v))
    if isinstance(v, str):
        return toml_str(v)
    if isinstance(v, list):
        return "[" + ", ".join(toml_any(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join("%s = %s" % (toml_key(k), toml_any(x)) for k, x in v.items()) + " }"
    if hasattr(v, "isoformat"):  # datetime, date and time
        return v.isoformat()
    raise TypeError("unsupported TOML value")


def codex_servers(data):
    servers = (data or {}).get("mcp_servers")
    return servers if isinstance(servers, dict) else {}


def codex_extras(data, names):
    """The settings agentainer does not write on the servers NAMES in the parsed
    config DATA, by name."""
    servers = codex_servers(data)
    return {name: {k: v for k, v in servers[name].items() if k not in CODEX_OWN_KEYS}
            for name in names if isinstance(servers.get(name), dict)}


def toml_same(a, b):
    """Equality for parsed TOML that also compares types (false is not 0, 1 is not
    1.0) and treats nan as equal to nan."""
    if type(a) is not type(b):
        return False
    if isinstance(a, dict):
        return a.keys() == b.keys() and all(toml_same(a[k], b[k]) for k in a)
    if isinstance(a, list):
        return len(a) == len(b) and all(toml_same(x, y) for x, y in zip(a, b))
    if isinstance(a, float) and a != a:
        return b != b
    return a == b


def codex_check_kept(old, new, owned, written, warn):
    """Raise unless NEW keeps every setting of OLD apart from the keys agentainer
    writes on its own servers. A server removed from mcp.json loses all its keys."""
    before = tomllib.loads(old)
    try:
        after = tomllib.loads(new)
    except tomllib.TOMLDecodeError:
        after = None
    if after is not None:
        for data, names, removed in ((before, owned, set(owned) - set(written)), (after, written, set())):
            servers = data.get("mcp_servers")
            if not isinstance(servers, dict):
                continue
            for name in names:
                rest = {k: v for k, v in (servers.get(name) or {}).items() if k not in CODEX_OWN_KEYS}
                if rest and name not in removed:
                    servers[name] = rest
                else:
                    servers.pop(name, None)
            if not servers:
                del data["mcp_servers"]
    if after is None or not toml_same(before, after):
        warn(CODEX_LAYOUT)
        raise ValueError("codex settings check failed")


def codex_user_servers(text):
    """Server names the user defined, in any TOML spelling."""
    if tomllib is not None:
        return set((tomllib.loads(text).get("mcp_servers") or {}).keys())
    names, section = set(), None
    for line in text.splitlines():
        s = line.strip()
        header = re.match(r"^\[\[?\s*([^\]]+?)\s*\]\]?\s*(#.*)?$", s)
        if header:
            section = header.group(1).replace('"', "")
            m = re.match(r"^mcp_servers\.([A-Za-z0-9_-]+)", section)
            if m:
                names.add(m.group(1))
            continue
        dotted = re.match(r'^mcp_servers\."?([A-Za-z0-9_-]+)"?\.', s)
        if dotted and section is None:
            names.add(dotted.group(1))
        inline = re.match(r'^"?([A-Za-z0-9_-]+)"?\s*[=.]', s)
        if inline and section == "mcp_servers":
            names.add(inline.group(1))
    return names


def sync_codex(home, desired, managed, warn):
    path = os.path.join(home, ".codex", "config.toml")
    try:
        with open(path) as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    parsed = None
    if tomllib is not None:
        try:
            parsed = tomllib.loads(text)
        except tomllib.TOMLDecodeError:
            warn("codex: config.toml is not valid TOML; nothing written")
            raise
    # Without a manifest entry, the servers inside intact markers that mcp.json still
    # lists are ours; any other server there is left to the user.
    owned = set(managed) or (codex_marked_names(text) & set(desired))
    extras = codex_extras(parsed, owned)
    outside = codex_drop_owned(text, owned)
    try:
        taken = codex_user_servers(outside)
    except Exception:  # noqa: BLE001 - tomllib.TOMLDecodeError when tomllib exists
        warn(CODEX_LAYOUT)
        raise
    result, tables = [], []
    for name, s in desired.items():
        if name in taken:
            warn("codex already has a server named %s that agentainer did not add; leaving it" % name)
            continue
        table = codex_table(name, s, warn)
        if table is None:
            continue
        table += "".join("%s = %s\n" % (toml_key(k), toml_any(v)) for k, v in extras.get(name, {}).items())
        if parsed is not None and name in owned:
            # Warn when removing an owned key that mcp.json does not set.
            written = codex_servers(tomllib.loads(table)).get(name, {})
            gone = sorted(k for k in codex_servers(parsed).get(name, {}) if k in CODEX_OWN_KEYS and k not in written)
            if gone:
                warn("codex: %s: removed %s, which mcp.json does not set; add it to mcp.json to keep it"
                     % (name, ", ".join(gone)))
        tables.append(table)
        result.append(name)
    new = outside.rstrip("\n")
    if tables:
        new += ("\n\n" if new else "") + MARK_BEGIN + "\n" + "\n".join(tables) + MARK_END
    new += "\n" if new else ""
    if tomllib is not None:
        # Never write a file Codex cannot load, or one that lost a setting we do not own.
        codex_check_kept(text, new, owned, result, warn)
    return path, new, result


# ---- opencode (opencode.json entries) ---------------------------------------------

def oc_value(warn, name, field, v):
    n = ref_name(v)
    if n:
        return "{env:%s}" % n
    check_partial(warn, "opencode", name, field, v)
    return v


def opencode_entry(name, s, warn):
    """Same shape "opencode mcp add" writes in OpenCode v2."""
    if "command" in s:
        e = {"type": "local", "command": [s["command"]] + s.get("args", [])}
        if s.get("env"):
            e["environment"] = {k: oc_value(warn, name, k, v) for k, v in s["env"].items()}
        return e
    if is_sse(s):
        warn("opencode: %s uses SSE; it is written as a remote server, and whether OpenCode "
             "connects to SSE servers is not verified" % name)
    e = {"type": "remote", "url": s["url"]}
    if s.get("headers"):
        hdr = {}
        for k, v in s["headers"].items():
            m = BEARER.match(v)
            hdr[k] = "Bearer {env:%s}" % m.group(1) if m else oc_value(warn, name, k, v)
        e["headers"] = hdr
    return e


def sync_opencode(home, desired, managed, warn):
    base = os.path.join(home, ".config", "opencode")
    path = os.path.join(base, "opencode.json")
    if os.path.exists(os.path.join(base, "opencode.jsonc")):
        raise RuntimeError("opencode.jsonc is in use; agentainer does not edit it")
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    if not isinstance(data, dict) or not isinstance(data.setdefault("mcp", {}), dict) \
            or not isinstance(data["mcp"].setdefault("servers", {}), dict):
        raise RuntimeError("%s does not have the expected mcp.servers object" % path)
    servers = data["mcp"]["servers"]
    for name in managed:
        if name not in desired:
            servers.pop(name, None)
    result = []
    for name, s in desired.items():
        if name in servers and name not in managed:
            warn("opencode already has a server named %s that agentainer did not add; leaving it" % name)
            continue
        servers[name] = opencode_entry(name, s, warn)
        result.append(name)
    return path, json.dumps(data, indent=2, ensure_ascii=False) + "\n", result


# ---- Interrupted configuration writes -------------------------------------------


def file_hash(path):
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except FileNotFoundError:
        return None


def recover_pending(box, env, manifest_path, manifest):
    """Finish ownership only when the config matches a journaled atomic write."""
    recovered = False
    for agent in AGENTS:
        pending_path = os.path.join(box, "mcp-pending-%s.json" % agent)
        try:
            with open(pending_path) as f:
                pending = json.load(f)
        except FileNotFoundError:
            continue
        recovered = True
        path = os.path.realpath(agent_config_path(agent, env))
        if pending["path"] != path:
            raise ValueError("interrupted write belongs to another config path")
        current = file_hash(path)
        if current == pending["after"]:
            manifest[agent] = pending["managed"]
            write_atomic(manifest_path, json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        elif current != pending["before"]:
            raise ValueError("config changed after interrupted sync; inspect " + pending_path)
        os.unlink(pending_path)
    return recovered


def commit_config(box, agent, plan, manifest_path, manifest, private=False):
    path, text, names = plan
    pending_path = os.path.join(box, "mcp-pending-%s.json" % agent)
    pending = {"path": os.path.realpath(path), "before": file_hash(path),
               "after": hashlib.sha256(text.encode("utf-8")).hexdigest(), "managed": names}
    # Hashes record the intended write without copying credentials into a journal.
    write_atomic(pending_path, json.dumps(pending, sort_keys=True) + "\n")
    if private:
        write_atomic(path, text, private=True)
    else:
        write_atomic(path, text)
    manifest[agent] = names
    write_atomic(manifest_path, json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    os.unlink(pending_path)


@contextlib.contextmanager
def sync_lock(box):
    """Serialize direct and startup syncs, including their manifests and hash stamps."""
    os.makedirs(box, exist_ok=True)
    # Python opens the descriptor non-inheritable; agent subprocesses cannot retain it.
    with open(os.path.join(box, ".mcp-sync.lock"), "a") as lock:
        deadline = time.monotonic() + 120
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError("another sync held the MCP lock for 120 seconds")
                time.sleep(0.1)
        yield


def sync(env, if_changed, warn):
    home = env["HOME"]
    box = os.path.join(home, ".agentainer")
    manifest_path = os.path.join(box, "mcp-managed.json")
    stamp = os.path.join(box, ".mcp-synced.sha256")
    try:
        with open(os.path.join(box, "mcp.json"), "rb") as f:
            current = hashlib.sha256(f.read()).hexdigest()
    except FileNotFoundError:
        current = None
    try:
        with open(manifest_path) as f:
            manifest = json.load(f)
        if not isinstance(manifest, dict):
            manifest = {}
    except (FileNotFoundError, ValueError):
        manifest = {}
    try:
        recovered = recover_pending(box, env, manifest_path, manifest)
    except (OSError, ValueError, KeyError, TypeError):
        warn("interrupted sync cannot be recovered; inspect mcp-pending-*.json and agent configs")
        return 1
    if if_changed and not recovered:
        try:
            with open(stamp) as f:
                previous = f.read().strip()
        except FileNotFoundError:
            if current is None:
                return 0
        else:
            if current is not None and previous == current:
                return 0

    try:
        desired = load_desired(os.path.join(box, "mcp.json"), warn)
    except Invalid as e:
        print("agentainer-mcp: %s; nothing changed" % e, file=sys.stderr)
        return 1

    # A partial sync must never reuse an earlier successful input's stamp.
    try:
        os.unlink(stamp)
    except FileNotFoundError:
        pass
    failed = False
    private = any(not REF.fullmatch(value) and not BEARER.fullmatch(value)
                  for server in desired.values()
                  for field in ("env", "headers") for value in server.get(field, {}).values())
    steps = [("claude", lambda m: sync_json_agent("claude", env, desired, m, warn)),
             ("agy", lambda m: sync_json_agent("agy", env, desired, m, warn)),
             ("codex", lambda m: sync_codex(home, desired, m, warn)),
             ("opencode", lambda m: sync_opencode(home, desired, m, warn))]
    for agent, step in steps:
        if shutil.which(agent, path=env.get("PATH")) is None:
            continue
        try:
            commit_config(box, agent, step(manifest.get(agent, [])), manifest_path, manifest, private=private)
        except Exception as e:  # noqa: BLE001 - one agent's failure must not stop the others
            failed = True
            # Parser and filesystem errors may contain configuration values.
            warn("%s: not updated (%s); run 'agentainer-mcp sync' to retry" % (agent, type(e).__name__))
    if failed:
        return 1
    if current is None:
        try:
            os.unlink(stamp)
        except FileNotFoundError:
            pass
    else:
        write_atomic(stamp, current + "\n")
    return 0


def main(argv=None, env=None):
    argv = sys.argv[1:] if argv is None else argv
    env = dict(os.environ) if env is None else env
    if argv not in ([], ["sync"], ["sync", "--if-changed"], ["list"]):
        print("usage: agentainer-mcp sync [--if-changed]|list", file=sys.stderr)
        return 2
    box = os.path.join(env["HOME"], ".agentainer")
    if argv == ["list"]:
        try:
            with open(os.path.join(box, "mcp-managed.json")) as f:
                manifest = json.load(f)
            if not isinstance(manifest, dict):
                manifest = {}
        except (FileNotFoundError, ValueError):
            manifest = {}
        for agent in AGENTS:
            print("%s: %s" % (agent, ", ".join(manifest.get(agent, [])) or "(none)"))
        return 0

    def warn(msg):
        print("agentainer-mcp: warning: %s" % msg, file=sys.stderr)

    try:
        with sync_lock(box):
            return sync(env, "--if-changed" in argv, warn)
    except (OSError, TimeoutError) as e:
        warn("sync failed: %s" % e)
        return 1


if __name__ == "__main__":
    sys.exit(main())
